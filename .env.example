# Alamat server (jangan diekspos ke publik — aplikasi ini menjalankan perintah sebagai user Anda)
HOST=127.0.0.1
PORT=4320

# Pagar Host/Origin (anti DNS rebinding, CSRF, dan pembajakan WebSocket).
# Bawaan yang selalu diizinkan: 127.0.0.1, localhost, ::1 (di port PORT dan 4321/Vite), ditambah
# ai-team.local kalau /etc/hosts mengarahkannya ke 127.0.0.1.
# Tambahkan nama/origin lain di sini kalau UI dibuka lewat alamat lain, dipisah koma.
ALLOWED_HOSTS=
ALLOWED_ORIGINS=

# Folder kerja BAWAAN (dipakai project yang tidak punya folder sendiri;
# folder per project diatur di halaman Project → Setelan)
WORKSPACE_DIR=/var/www/ai-team/workspace

# Tempat transcript, state, dan laporan QA
DATA_DIR=./data

# Model per role (kosongkan untuk pakai default Claude Code)
MODEL_QA=claude-sonnet-5-5
MODEL_ENGINEER=claude-opus-5
MODEL_DEVOPS=claude-opus-5
MODEL_UIUX=claude-opus-5-5

# Kedalaman berpikir per role: low | medium | high | xhigh | max
# (high = jawaban paling teliti tapi paling lambat & paling boros kuota)
EFFORT_QA=high
EFFORT_ENGINEER=high
EFFORT_DEVOPS=medium
EFFORT_UIUX=high

# Mode awal tiap bot saat data/settings.json belum ada: auto | ask | readonly
# (setelah itu halaman Pengaturan di aplikasi yang berlaku)
AUTONOMY_QA=ask
AUTONOMY_ENGINEER=ask
AUTONOMY_DEVOPS=ask
AUTONOMY_UIUX=ask

# Maksimal agen yang berjalan bersamaan (menahan konsumsi rate limit langganan)
MAX_CONCURRENT_AGENTS=2

# Tutup subprocess tugas yang menganggur setelah sekian milidetik (sesi tetap bisa dilanjutkan)
IDLE_SHUTDOWN_MS=600000

# 1 = ikut memuat skill/plugin global dari ~/.claude (default: 0, konteks bersih)
INCLUDE_USER_SETTINGS=0

# URL target BAWAAN (dipakai project yang tidak punya URL sendiri)
TARGET_URL=
